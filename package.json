{
 "name": "besked",
 "version": "1.3.0",
 "description": "Besked",
 "author": "Besked",
 "main": "main.js",
 "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win nsis --publish never"
 },
 "dependencies": {
  "electron-updater": "^6.3.0"
 },
 "devDependencies": {
  "electron": "^33.0.0",
  "electron-builder": "^25.0.0"
 },
 "build": {
  "appId": "dk.besked.app",
  "productName": "Besked",
  "files": [
   "main.js",
   "preload.js",
   "index.html",
   "icons.js",
   "icon.png",
   "package.json"
  ],
  "win": {
   "target": "nsis",
   "signAndEditExecutable": false,
   "icon": "icon.png"
  },
  "nsis": {
   "oneClick": true,
   "perMachine": false
  },
  "publish": {
   "provider": "github",
   "owner": "0304mattidk-source",
   "repo": "besked-1.1",
   "releaseType": "release"
  }
 }
}